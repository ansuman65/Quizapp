<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base app theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/blue_accent</item>
        <item name="colorPrimaryDark">@color/blue_accent</item>
        <item name="colorAccent">@color/orange_accent</item>
    </style>

    <!-- Shared base style -->
    <style name="RoundedQuizButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:textColor">@color/button_text_light</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Per-color styles -->
    <style name="QuizButtonRed" parent="RoundedQuizButtonBase">
        <item name="android:backgroundTint">@color/red_accent</item>
    </style>

    <style name="QuizButtonOrange" parent="RoundedQuizButtonBase">
        <item name="android:backgroundTint">@color/orange_accent</item>
    </style>

    <style name="QuizButtonBlue" parent="RoundedQuizButtonBase">
        <item name="android:backgroundTint">@color/blue_accent</item>
    </style>

    <style name="QuizButtonPurple" parent="RoundedQuizButtonBase">
        <item name="android:backgroundTint">@color/purple_accent</item>
    </style>

    <style name="QuizButtonGreen" parent="RoundedQuizButtonBase">
        <item name="android:backgroundTint">@color/green_accent</item>
    </style>


</resources>
